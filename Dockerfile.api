# Leaderboard API: plain Node 22 with the built-in node:sqlite, no npm install needed.
FROM node:22-alpine
WORKDIR /app
COPY server/ ./server/
ENV PORT=3002 DB_PATH=/data/scores.db
VOLUME /data
EXPOSE 3002
# 127.0.0.1, not localhost: busybox wget resolves localhost to ::1 and the server binds IPv4 only.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q --spider http://127.0.0.1:3002/api/health || exit 1
CMD ["node", "server/index.mjs"]
